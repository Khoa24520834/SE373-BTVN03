# Sao chép file này thành ".env" (thư mục gốc repo) rồi điền giá trị thật. KHÔNG commit file .env.
# Nhà cung cấp chọn tự động theo key đang đặt (ưu tiên Google > Claude > OpenAI), hoặc đặt LLM_PROVIDER.

# ====================== Google (Gemini): đang dùng ======================
GOOGLE_API_KEY=your_api_key_here
GOOGLE_MODEL=gemini-3.8-flash

# ====================== Claude / OpenAI: không dùng ======================
# ANTHROPIC_API_KEY=your_api_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.6-luna
